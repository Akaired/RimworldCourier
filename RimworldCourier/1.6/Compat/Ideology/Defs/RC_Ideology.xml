<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Stand-ins for relics of other faiths, drawn with Ideology's relic textures. They have no ritual
    function: real relics belong to an ideoligion precept and cannot be generated as freight.
  -->
  <ThingDef ParentName="ResourceBase" Name="RC_CourierRelicBase" Abstract="True">
    <thingClass>ThingWithComps</thingClass>
    <description>A sacred object of another faith, entrusted to couriers. It holds no power of its own, but it means a great deal to those who believe in it.</description>
    <stackLimit>1</stackLimit>
    <tradeNeverStack>true</tradeNeverStack>
    <useHitPoints>true</useHitPoints>
    <drawGUIOverlay>false</drawGUIOverlay>
    <healthAffectsPrice>false</healthAffectsPrice>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Beauty>2</Beauty>
      <MarketValue>600</MarketValue>
      <Flammability>0.2</Flammability>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="RC_CourierRelicBase">
    <defName>RC_Relic_Chalice</defName>
    <label>sacred chalice</label>
    <graphicData>
      <texPath>Things/Item/Relic/RelicInertCup</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(205, 175, 110)</color>
    </graphicData>
    <statBases>
      <Mass>1.5</Mass>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="RC_CourierRelicBase">
    <defName>RC_Relic_Pendant</defName>
    <label>sacred pendant</label>
    <graphicData>
      <texPath>Things/Item/Relic/RelicInertPendant</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <color>(205, 175, 110)</color>
    </graphicData>
    <statBases>
      <Mass>0.5</Mass>
    </statBases>
  </ThingDef>

  <ThingDef ParentName="RC_CourierRelicBase">
    <defName>RC_Relic_Reliquary</defName>
    <label>reliquary box</label>

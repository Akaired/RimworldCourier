    <groups>
      <li>RC_Relics</li>
    </groups>
  </RimworldCourier.CourierReasonDef>

  <RimworldCourier.CourierReasonDef>
    <defName>RC_Reason_PeaceOffering</defName>
    <label>peace offering</label>
    <clause>as a peace offering between two faiths</clause>
    <groups>
      <li>RC_Relics</li>
    </groups>
    <recipient>OtherFaction</recipient>
  </RimworldCourier.CourierReasonDef>

  <RimworldCourier.CourierReasonDef>
    <defName>RC_Reason_HiddenFromRaiders</defName>
    <label>hidden relic</label>
    <clause>to hide it from raiders</clause>
    <groups>
      <li>RC_Relics</li>
    </groups>
    <recipient>SameFaction</recipient>
  </RimworldCourier.CourierReasonDef>

  <RimworldCourier.CourierReasonDef>
    <defName>RC_Reason_ImportantRitual</defName>

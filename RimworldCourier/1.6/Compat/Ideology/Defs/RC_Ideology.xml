  <RimworldCourier.CourierCargoGroupDef>
    <defName>RC_Relics</defName>
    <label>relics</label>
    <weight>3</weight>
    <maxCount>1</maxCount>
    <things>
      <li>RC_Relic_Chalice</li>
      <li>RC_Relic_Pendant</li>
      <li>RC_Relic_Reliquary</li>
      <li>RC_Relic_Tablet</li>
      <li>RC_Relic_Fragment</li>
      <li>RC_Relic_Hilt</li>
      <li>RC_Relic_Ark</li>
      <li>RC_Relic_Cube</li>
    </things>
  </RimworldCourier.CourierCargoGroupDef>

  <RimworldCourier.CourierReasonDef>
    <defName>RC_Reason_NewTemple</defName>
    <label>new temple</label>
    <clause>to be enshrined in a new temple</clause>
    <groups>
      <li>RC_Relics</li>
    </groups>
  </RimworldCourier.CourierReasonDef>

  <RimworldCourier.CourierReasonDef>
    <defName>RC_Reason_ReturnFromExile</defName>
    <label>return from exile</label>
    <clause>returned to the faithful after a long exile</clause>
    <groups>
      <li>RC_Relics</li>
    </groups>
  </RimworldCourier.CourierReasonDef>

  <RimworldCourier.CourierReasonDef>
    <defName>RC_Reason_Pilgrimage</defName>
    <label>pilgrimage</label>
